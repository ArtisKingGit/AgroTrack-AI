# ==============================================================================
# AgroTrack AI — Platform Environment Configuration Template
# ==============================================================================
# Copy this file to 'backend/.env' and customize for your environment.
# Never commit real API keys, credentials, or production tokens to source control.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=5500
ENVIRONMENT=development

# Security & CORS Settings
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://agrotrack.ai

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration
FIREBASE_PROJECT_ID=project-beta-7f0a3
FIREBASE_DATABASE_URL=https://project-beta-7f0a3-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=project-beta-7f0a3.firebasestorage.app
