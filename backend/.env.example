# ==============================================================================
# AgroTrack AI — Platform Environment Configuration Template
# ==============================================================================
# Copy this file to 'backend/.env' and customize for your environment.
# Never commit real API keys, credentials, or production tokens to source control.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=5500
ENVIRONMENT=development

# Authentication & Security
# Set to 'false' in staging/production to strictly enforce live Firebase ID token verification.
# When false or ENVIRONMENT=production, all mock tokens (mock-token-*, mock-jwt:*) and unsigned JWTs are rejected.
ALLOW_DEV_MOCK_AUTH=true

# Security & CORS Settings (comma-separated origins; no wildcards with credentials in production)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://agrotrack.ai

# Database Storage Configuration (SQLite in Write-Ahead Logging WAL mode)
# Default path: backend/data/agrotrack.db
# AGROTRACK_DB_PATH=backend/data/agrotrack.db

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Configuration
FIREBASE_CREDENTIALS_PATH=backend/serviceAccountKey.json
FIREBASE_PROJECT_ID=ksef-project-dylan
FIREBASE_DATABASE_URL=https://ksef-project-dylan-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=ksef-project-dylan.appspot.com
